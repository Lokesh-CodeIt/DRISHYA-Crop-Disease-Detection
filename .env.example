# ==============================================================================
# DRISHYA: Explainable Crop Disease Detection System
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as required for your environment.
# NEVER commit the active .env file to version control.

# Local Session & Authentication Security
AUTH_SECRET_KEY=change-this-insecure-secret-key-to-a-strong-random-string
AUTH_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME=drishya_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Local Database Configuration (SQLite)
DATABASE_PATH=database/leaflens.db

# Uncertainty Rejection Policy Threshold
UNCERTAINTY_REJECTION_THRESHOLD=0.65
