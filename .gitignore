# ==============================================================================
# DRISHYA: Explainable Crop Disease Detection System — .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment and Secrets (Strict security rule: NEVER commit secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json
service_account.json

# ------------------------------------------------------------------------------
# 2. Local Database & Runtime State (Strict user-safety: NEVER commit user DB)
# ------------------------------------------------------------------------------
database/*.db
database/*.db-journal
database/*.sqlite
database/*.sqlite3
*.db
*.sqlite
*.sqlite3
!database/.gitkeep

# ------------------------------------------------------------------------------
# 3. Large Datasets, Raw Archives, and Backup Bundles (NEVER commit large assets)
# ------------------------------------------------------------------------------
DATASET/
COLAB_MIGRATION/
PROJECT_ARTIFACTS/
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.parquet
*.h5
*.hdf5

# Raw/Processed dataset directories (keep directory structure only)
ml/datasets/raw/*
!ml/datasets/raw/.gitkeep
ml/datasets/cleaned/*
!ml/datasets/cleaned/.gitkeep
ml/datasets/processed/*
!ml/datasets/processed/.gitkeep
ml/datasets/splits/*
!ml/datasets/splits/.gitkeep

# ------------------------------------------------------------------------------
# 4. Inactive Model Checkpoints & Temporary Formats
# ------------------------------------------------------------------------------
# Inactive experiment checkpoints (only production ml/models/ are tracked via Git LFS)
ml/experiments/*
!ml/experiments/.gitkeep
ml/checkpoints/*
!ml/checkpoints/.gitkeep
ml/exported_models/*
!ml/exported_models/.gitkeep

*.pwf
*.ckpt
*.engine
*.bin

# ------------------------------------------------------------------------------
# 5. Python and Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 6. Testing, Linting & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ------------------------------------------------------------------------------
# 7. Jupyter Notebooks Checkpoints
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ------------------------------------------------------------------------------
# 8. Frontend & Node Artifacts
# ------------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/build/
.npm/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 9. IDEs and Operating System Artifacts
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 10. Temporary, Scratch, and Debug outputs
# ------------------------------------------------------------------------------
scratch/
tmp/
temp/
data/reports/contact_sheets/
